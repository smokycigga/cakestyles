# --- Required ---
# MongoDB connection string. Create a free cluster at https://cloud.mongodb.com
# (Database Access user + Network Access 0.0.0.0/0 for Vercel, then "Connect > Drivers" for the URI)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cakestyles

# Secret used to sign admin JWTs — use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# --- Owner bootstrap (used once by `npm run seed`) ---
OWNER_EMAIL=owner@yourshop.com
OWNER_PASSWORD=ChooseAStrongPassword

# --- Optional ---
PORT=5000
# Razorpay test keys (Dashboard > Settings > API Keys). Online payments stay
# disabled until real keys are added here AND enabled in Admin > Settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Allowed browser origin for CORS (not needed on Vercel — same origin)
# CLIENT_URL=https://your-app.vercel.app
