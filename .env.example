# --- Required ---
# MongoDB connection string. Create a free cluster at https://cloud.mongodb.com
# (Database Access user + Network Access 0.0.0.0/0 for Vercel, then "Connect > Drivers" for the URI)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cakestyles

# Secret used to sign admin JWTs — use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# --- Owner bootstrap (used once by `npm run seed`) ---
OWNER_EMAIL=owner@yourshop.com
OWNER_PASSWORD=ChooseAStrongPassword

# --- Optional ---
PORT=5000
# Razorpay test keys (Dashboard > Settings > API Keys). Online payments stay
# disabled until real keys are added here AND enabled in Admin > Settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Allowed browser origin for CORS (not needed on Vercel — same origin)
# CLIENT_URL=https://your-app.vercel.app

# --- Cloudinary (optional, but strongly recommended) ---
# Product photos go to Cloudinary's CDN instead of being stored as buffers in
# MongoDB. This is what makes the menu load instantly: images are served at the
# exact size the layout needs, in WebP/AVIF where the browser supports it.
#
# Dashboard > (cloud name is shown top-left, also in every delivery URL)
# Dashboard > API Keys > "API environment variable" gives all three at once.
# Leave blank and uploads keep working — they fall back to database storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder to group uploads under
# CLOUDINARY_FOLDER=cakestyles/products

# --- New order alerts (optional, any one is enough) ---
# Every configured channel receives the alert. With none set, orders are only
# written to the server log. Recipients are edited in Admin > Settings; the
# variables here are the credentials, which is why they live in the environment.
#
# 1) Email — works with Gmail, Resend, SES, Postmark, anything SMTP.
#    Gmail needs an App Password (Google Account > Security > 2-Step
#    Verification > App passwords), NOT the normal account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=the-16-character-app-password
# SMTP_FROM=Cakestyles <youraccount@gmail.com>
# Overrides the recipients saved in Admin > Settings:
# ORDER_ALERT_EMAILS=owner@example.com

# 2) Telegram — a real push notification on a phone, free.
#    Message @BotFather > /newbot > copy the token. Then open the new bot and
#    send it any message once; the chat id is discovered automatically.
# TELEGRAM_BOT_TOKEN=123456789:AA...

# 3) ntfy — push to the ntfy app, no account needed (https://ntfy.sh).
#    Pick a long random topic name; anyone who knows it can read it.
# NTFY_TOPIC=cakestyles-orders-8f3k2m
# NTFY_SERVER=https://ntfy.sh

# Used to build the "Open in admin" link inside an alert
# PUBLIC_APP_URL=https://www.cakestyles.in
